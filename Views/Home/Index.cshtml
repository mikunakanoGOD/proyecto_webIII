@model IEnumerable<PortalMicrocursos.Models.Curso>
@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container text-center">
        <h1 class="fw-bold mb-3">
            <i class="bi bi-mortarboard-fill me-3"></i>Aprende a tu ritmo
        </h1>
        <p class="mb-4">Accede a microcursos diseñados por expertos. Flexibles, prácticos y en tu idioma.</p>
        <a asp-controller="Cursos" asp-action="Index" class="btn btn-light btn-lg fw-semibold px-5">
            <i class="bi bi-collection-play me-2"></i>Ver todos los cursos
        </a>
    </div>
</div>

<div class="container">

    <!-- Estadísticas rápidas -->
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-book-fill" style="font-size:2rem;color:#667eea"></i>
                <h3 class="fw-bold mt-2">@Model.Count()</h3>
                <p class="text-muted">Cursos disponibles</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-lightning-fill" style="font-size:2rem;color:#fd7e14"></i>
                <h3 class="fw-bold mt-2">100%</h3>
                <p class="text-muted">Contenido práctico</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3">
                <i class="bi bi-award-fill" style="font-size:2rem;color:#28a745"></i>
                <h3 class="fw-bold mt-2">Gratis</h3>
                <p class="text-muted">Sin costo de inscripción</p>
            </div>
        </div>
    </div>

    <!-- Cursos destacados -->
    @if (Model.Any())
    {
        <h2 class="section-title">Cursos recientes</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            @foreach (var curso in Model)
            {
                <div class="col">
                    <div class="card curso-card h-100">
                        <div class="card-header py-3">
                            <i class="bi bi-play-circle-fill me-2"></i>
                            <span class="fw-semibold">@curso.Nivel</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@curso.Titulo</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @(curso.Descripcion.Length > 120 ? curso.Descripcion.Substring(0, 120) + "…" : curso.Descripcion)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="text-muted small">
                                    <i class="bi bi-clock me-1"></i>@curso.Duracion min
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-list-ul me-1"></i>@(curso.Lecciones?.Count ?? 0) lecciones
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-controller="Cursos" asp-action="Detalle" asp-route-id="@curso.Id"
                               class="btn btn-outline-primary w-100">
                                Ver curso <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mb-5">
            <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-lg px-5">
                Ver todos los cursos <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-collection" style="font-size:4rem;color:#ccc"></i>
            <h3 class="mt-3 text-muted">Aún no hay cursos publicados</h3>
            <p class="text-muted">Vuelve pronto para ver el contenido disponible.</p>
        </div>
    }

    <!-- CTA para no autenticados -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="card border-0 text-white text-center p-5 mb-5"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px;">
            <h2 class="fw-bold">¿Listo para aprender?</h2>
            <p class="mb-4 opacity-75">Crea tu cuenta gratis y accede a todos nuestros microcursos.</p>
            <div>
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg fw-semibold px-5 me-2">
                    <i class="bi bi-person-plus me-2"></i>Registrarse gratis
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-5">
                    Iniciar sesión
                </a>
            </div>
        </div>
    }
</div>
