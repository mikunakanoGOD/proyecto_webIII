@model IEnumerable<PortalMicrocursos.Models.Curso>
@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero retro -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <div class="hero-eyebrow">&gt; @Model.Count() CURSOS DISPONIBLES_</div>
                <h1 class="hero-title"><span class="t1">MICRO</span><span class="t2">CURSOS</span></h1>
                <p class="hero-sub my-3">APRENDE A TU RITMO.<br />LECCIONES CORTAS. PROGRESO GUARDADO.</p>
                <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-lg me-2 mb-2">
                    &gt; Ver cursos
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Inscripciones" asp-action="MisCursos" class="btn btn-outline-primary btn-lg mb-2">Mis cursos</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg mb-2">Registrarse</a>
                }
            </div>
            <div class="col-md-5 text-center">
                <svg viewBox="0 0 150 120" class="hero-pc" shape-rendering="crispEdges" role="img" aria-label="Computadora retro con una carpeta en pantalla">
                    <polygon points="95,4 101,22 118,12 112,30 134,32 116,42 128,58 108,52 104,72 92,56 78,66 82,46 62,40 80,32 72,14 90,22" fill="#7a4fd1" opacity=".55" />
                    <rect x="30" y="14" width="76" height="62" fill="#d8cdb0" /><rect x="30" y="14" width="76" height="3" fill="#efe6cf" /><rect x="103" y="14" width="3" height="62" fill="#a89e82" />
                    <rect x="38" y="22" width="58" height="46" fill="#14103a" /><rect x="40" y="24" width="54" height="42" fill="#1e8a8f" />
                    <rect x="56" y="34" width="22" height="3" fill="#ffc857" /><rect x="54" y="37" width="26" height="16" fill="#ffc857" /><rect x="54" y="37" width="26" height="2" fill="#ffe08a" /><rect x="54" y="50" width="26" height="3" fill="#c98a00" />
                    <rect x="52" y="58" width="30" height="2" fill="#f3e9d2" />
                    <rect x="82" y="50" width="2" height="10" fill="#fff" /><rect x="84" y="52" width="2" height="2" fill="#fff" /><rect x="86" y="54" width="2" height="2" fill="#fff" />
                    <rect x="46" y="76" width="44" height="5" fill="#bfb496" />
                    <rect x="18" y="82" width="100" height="14" fill="#d8cdb0" /><rect x="18" y="82" width="100" height="2" fill="#efe6cf" /><rect x="24" y="88" width="34" height="3" fill="#8f8568" /><rect x="104" y="87" width="5" height="3" fill="#2ec4b6" />
                    <rect x="24" y="100" width="88" height="14" fill="#efe6cf" /><rect x="24" y="100" width="88" height="2" fill="#fff" />
                    <g fill="#bfb496">
                        <rect x="28" y="104" width="6" height="3" /><rect x="36" y="104" width="6" height="3" /><rect x="44" y="104" width="6" height="3" /><rect x="52" y="104" width="6" height="3" /><rect x="60" y="104" width="6" height="3" /><rect x="68" y="104" width="6" height="3" /><rect x="76" y="104" width="6" height="3" /><rect x="84" y="104" width="6" height="3" /><rect x="92" y="104" width="6" height="3" /><rect x="100" y="104" width="6" height="3" /><rect x="34" y="109" width="62" height="3" />
                    </g>
                    <g fill="#ffc857"><rect x="8" y="30" width="2" height="6" /><rect x="6" y="32" width="6" height="2" /><rect x="132" y="70" width="2" height="6" /><rect x="130" y="72" width="6" height="2" /></g>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Franja naranja -->
<div class="banner-hola py-2">
    <div class="container d-flex flex-wrap align-items-center gap-3">
        <span class="hola">¡HOLA!</span>
        <span class="flex-grow-1">Aprender no tiene que ser aburrido. Elige un curso y empieza hoy.</span>
        <span>GRATIS · SIN TARJETA</span>
    </div>
</div>

<!-- Niveles -->
<div class="franja-niveles">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a asp-controller="Cursos" asp-action="Index" asp-route-nivel="Básico" class="text-decoration-none">
                    <div class="card h-100"><div class="card-header"><span>Básico</span><span class="float-end">■</span></div>
                        <div class="stat-win"><i class="bi bi-flower1" style="font-size:2rem;color:#1e8a8f"></i><div class="lbl mt-1">Empieza desde cero</div></div></div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Cursos" asp-action="Index" asp-route-nivel="Intermedio" class="text-decoration-none">
                    <div class="card h-100"><div class="card-header"><span>Intermedio</span><span class="float-end">■</span></div>
                        <div class="stat-win"><i class="bi bi-code-slash" style="font-size:2rem;color:#4b3a9c"></i><div class="lbl mt-1">Practica y mejora</div></div></div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Cursos" asp-action="Index" asp-route-nivel="Avanzado" class="text-decoration-none">
                    <div class="card h-100"><div class="card-header"><span>Avanzado</span><span class="float-end">■</span></div>
                        <div class="stat-win"><i class="bi bi-rocket-takeoff" style="font-size:2rem;color:#ff8a3d"></i><div class="lbl mt-1">Nivel experto</div></div></div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Inscripciones" asp-action="MisCursos" class="text-decoration-none">
                    <div class="card h-100"><div class="card-header"><span>Mi progreso</span><span class="float-end">■</span></div>
                        <div class="stat-win"><i class="bi bi-trophy" style="font-size:2rem;color:#b87400"></i><div class="lbl mt-1">Sigue tu avance</div></div></div>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container">

    <!-- Cursos destacados -->
    @if (Model.Any())
    {
        <h2 class="section-title">Cursos recientes</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
            @foreach (var curso in Model)
            {
                var nivelClase = curso.Nivel switch
                {
                    "Básico" => "nivel-basico",
                    "Intermedio" => "nivel-intermedio",
                    "Avanzado" => "nivel-avanzado",
                    _ => ""
                };
                <div class="col">
                    <div class="card curso-card h-100">
                        <div class="card-header"><span>curso_@(curso.Id).html</span><span class="float-end">_ x</span></div>
                        <div class="curso-portada @nivelClase">&lt;/&gt; @curso.Nivel.ToUpper()</div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@curso.Titulo</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @(curso.Descripcion.Length > 120 ? curso.Descripcion.Substring(0, 120) + "…" : curso.Descripcion)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="chip-info"><i class="bi bi-clock me-1"></i>@curso.Duracion min</span>
                                <span class="chip-info"><i class="bi bi-list-ul me-1"></i>@(curso.Lecciones?.Count ?? 0) lecc.</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a asp-controller="Cursos" asp-action="Detalle" asp-route-id="@curso.Id"
                               class="btn btn-outline-primary w-100">
                                Ver curso <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mb-5">
            <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary btn-lg px-5">
                Ver todos los cursos <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="card mx-auto mb-5" style="max-width:520px">
            <div class="card-header"><span>aviso.txt</span></div>
            <div class="card-body text-center py-5">
                <i class="bi bi-collection" style="font-size:3rem;color:#4b3a9c"></i>
                <h3 class="mt-3">Aún no hay cursos publicados</h3>
                <p class="text-muted mb-0">Vuelve pronto para ver el contenido disponible.</p>
            </div>
        </div>
    }

    <!-- CTA para no autenticados -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="card mb-5">
            <div class="card-header"><span>unete.exe</span><span class="float-end">_ □ x</span></div>
            <div class="card-body text-center p-5">
                <h2 style="color:#4b3a9c">¿Listo para aprender?</h2>
                <p class="mb-4 text-muted">Crea tu cuenta gratis y accede a todos nuestros microcursos.</p>
                <div>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2 mb-2">
                        <i class="bi bi-person-plus me-2"></i>Registrarse gratis
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg mb-2">
                        Iniciar sesión
                    </a>
                </div>
            </div>
        </div>
    }
</div>
