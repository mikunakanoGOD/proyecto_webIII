@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="bi bi-shield-x" style="font-size:5rem;color:#dc3545"></i>
            <h1 class="mt-3 fw-bold text-danger">Acceso denegado</h1>
            <p class="lead text-muted">No tienes permisos para acceder a esta sección.</p>
            <p class="text-muted">Si crees que esto es un error, contacta al administrador del portal.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-house me-2"></i>Volver al inicio
            </a>
        </div>
    </div>
</div>
