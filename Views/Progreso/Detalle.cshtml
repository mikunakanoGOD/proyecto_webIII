@using PortalMicrocursos.Services
@model ProgresoDetalle
@{
    ViewData["Title"] = "Mi Progreso";
    var curso = ViewData["Curso"] as PortalMicrocursos.Models.Curso;
    var lecciones = ViewData["Lecciones"] as IEnumerable<PortalMicrocursos.Models.Leccion>
                    ?? Enumerable.Empty<PortalMicrocursos.Models.Leccion>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Inscripciones" asp-action="MisCursos">Mis Cursos</a>
            </li>
            <li class="breadcrumb-item active">Mi Progreso — @Model.CursoTitulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Tarjeta de resumen -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-4">
                @if (Model.CursoCompletado)
                {
                    <i class="bi bi-trophy-fill text-warning" style="font-size:4rem"></i>
                    <h3 class="mt-3 fw-bold text-success">¡Completado!</h3>
                    <p class="text-muted">Has terminado todo el curso.</p>
                }
                else
                {
                    <div class="position-relative d-inline-block mx-auto" style="width:120px;height:120px">
                        <svg viewBox="0 0 36 36" style="transform:rotate(-90deg)" width="120" height="120">
                            <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e9ecef" stroke-width="2.5"/>
                            <circle cx="18" cy="18" r="15.9" fill="none"
                                    stroke="#667eea" stroke-width="2.5"
                                    stroke-dasharray="@Model.PorcentajeProgreso.ToString("F1") @(100 - Model.PorcentajeProgreso).ToString("F1")"
                                    stroke-linecap="round"/>
                        </svg>
                        <div class="position-absolute top-50 start-50 translate-middle fw-bold fs-4">
                            @Model.PorcentajeProgreso.ToString("F0")%
                        </div>
                    </div>
                    <h5 class="fw-bold mt-3">Progreso actual</h5>
                }

                <div class="mt-3 text-muted">
                    <strong class="text-dark">@Model.LeccionesCompletadas</strong> de
                    <strong class="text-dark">@Model.TotalLecciones</strong> lecciones completadas
                </div>

                <div class="progress mt-3" style="height:10px">
                    <div class="progress-bar progress-bar-custom"
                         role="progressbar"
                         style="width:@Model.PorcentajeProgreso.ToString("F0")%"
                         aria-valuenow="@Model.PorcentajeProgreso"
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
            </div>
        </div>

        <!-- Detalle por lección -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-list-check me-2 text-primary"></i>Estado de las lecciones
                </div>
                <div class="card-body p-0">
                    @foreach (var leccion in lecciones.OrderBy(l => l.Orden))
                    {
                        bool completada = Model.IdsLeccionesCompletadas.Contains(leccion.Id);
                        <div class="d-flex align-items-center p-3 border-bottom gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                 style="width:36px;height:36px;min-width:36px;
                                        background:@(completada ? "#d1fae5" : "#f0f0f0");
                                        color:@(completada ? "#16a34a" : "#999")">
                                @if (completada)
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    @leccion.Orden
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold @(completada ? "text-success" : "")">@leccion.Titulo</div>
                            </div>
                            <div>
                                @if (completada)
                                {
                                    <span class="badge bg-success">Completada</span>
                                }
                                else
                                {
                                    <a asp-controller="Lecciones" asp-action="Ver"
                                       asp-route-cursoId="@curso?.Id" asp-route-leccionId="@leccion.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver lección
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a asp-controller="Inscripciones" asp-action="MisCursos" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Mis Cursos
                </a>
                @if (!Model.CursoCompletado && lecciones.Any())
                {
                    var pendiente = lecciones.OrderBy(l => l.Orden)
                                             .FirstOrDefault(l => !Model.IdsLeccionesCompletadas.Contains(l.Id));
                    if (pendiente != null)
                    {
                        <a asp-controller="Lecciones" asp-action="Ver"
                           asp-route-cursoId="@curso?.Id" asp-route-leccionId="@pendiente.Id"
                           class="btn btn-primary">
                            <i class="bi bi-play-fill me-2"></i>Continuar donde lo dejé
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
