@model PortalMicrocursos.Models.Curso
@{
    ViewData["Title"] = Model.Titulo;
    bool estaInscrito = (bool)(ViewData["EstaInscrito"] ?? false);
    int totalInscritos = (int)(ViewData["TotalInscritos"] ?? 0);
    var badgeClass = Model.Nivel switch {
        "Básico" => "badge-basico",
        "Intermedio" => "badge-intermedio",
        "Avanzado" => "badge-avanzado",
        _ => "bg-secondary"
    };
    var lecciones = (Model.Lecciones ?? new List<PortalMicrocursos.Models.Leccion>()).OrderBy(l => l.Orden).ToList();
}

<div class="container py-4">
    <div class="barra-volver">
        <a asp-controller="Cursos" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-1"></i>Volver a cursos</a>
    </div>
    <!-- Migas de pan -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cursos" asp-action="Index">Cursos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Titulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Columna principal -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header"><span>curso_@(Model.Id).html</span><span class="float-end">_ □ x</span></div>
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge @badgeClass">@Model.Nivel</span>
                        <span class="chip-info"><i class="bi bi-clock me-1"></i>@Model.Duracion min</span>
                        <span class="chip-info"><i class="bi bi-list-ul me-1"></i>@lecciones.Count lecciones</span>
                        <span class="chip-info"><i class="bi bi-people-fill me-1"></i>@totalInscritos inscritos</span>
                    </div>
                    <h1 class="h3 mb-3" style="color:#4b3a9c">@Model.Titulo</h1>
                    <p style="line-height:1.8;">@Model.Descripcion</p>
                </div>
            </div>

            <!-- Lecciones como explorador de archivos -->
            @if (lecciones.Any())
            {
                <div class="card">
                    <div class="card-header"><span>C:\curso_@(Model.Id)\lecciones</span><span class="float-end">_ □ x</span></div>
                    @foreach (var leccion in lecciones)
                    {
                        if (estaInscrito)
                        {
                            <div class="explorer-row">
                                <a asp-controller="Lecciones" asp-action="Ver"
                                   asp-route-cursoId="@Model.Id" asp-route-leccionId="@leccion.Id">
                                    <span class="ico">@leccion.Orden</span>
                                    <span>@leccion.Titulo</span>
                                    <span class="estado" style="color:#1e8a8f">ABRIR &gt;</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="explorer-row bloqueada">
                                <span class="ico">@leccion.Orden</span>
                                <span>@leccion.Titulo</span>
                                <span class="estado"><i class="bi bi-lock-fill"></i> Bloqueada</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <!-- Panel lateral -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 80px;">
                <div class="card-header"><span>inscripcion.exe</span><span class="float-end">■</span></div>
                <div class="card-body p-4">
                    @if (!Model.EstaPublicado)
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>Este curso no está publicado aún.
                        </div>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (estaInscrito)
                        {
                            <div class="text-center mb-3">
                                <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem"></i>
                                <p class="fw-semibold mt-2 text-success">¡Ya estás inscrito!</p>
                            </div>
                            @if (lecciones.Any())
                            {
                                var primeraLeccion = lecciones.First();
                                <a asp-controller="Lecciones" asp-action="Ver"
                                   asp-route-cursoId="@Model.Id" asp-route-leccionId="@primeraLeccion.Id"
                                   class="btn btn-success w-100 py-2">
                                    <i class="bi bi-play-fill me-2"></i>Continuar aprendiendo
                                </a>
                            }
                        }
                        else if (User.IsInRole("Suscriptor") || User.IsInRole("Administrador"))
                        {
                            <p class="text-muted mb-3">Inscríbete para acceder a todas las lecciones de este curso.</p>
                            <form asp-controller="Inscripciones" asp-action="Inscribir" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cursoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-primary w-100 py-2">
                                    <i class="bi bi-person-check me-2"></i>Inscribirme ahora
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-3">Inicia sesión o crea una cuenta para inscribirte en este curso.</p>
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="btn btn-primary w-100 py-2 mb-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </a>
                        <a asp-controller="Account" asp-action="Register"
                           class="btn btn-outline-primary w-100">
                            <i class="bi bi-person-plus me-2"></i>Crear cuenta gratis
                        </a>
                    }

                    <hr class="my-3" />
                    <div class="text-muted small">
                        <p class="mb-1"><i class="bi bi-calendar3 me-2"></i>Publicado: @Model.FechaCreacion.ToString("dd MMMM yyyy")</p>
                        <p class="mb-1"><i class="bi bi-award me-2"></i>Nivel: @Model.Nivel</p>
                        <p class="mb-0"><i class="bi bi-cash-coin me-2"></i>Costo: gratis</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
