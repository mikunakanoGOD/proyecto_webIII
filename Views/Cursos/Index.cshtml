@model IEnumerable<PortalMicrocursos.Models.Curso>
@{
    ViewData["Title"] = "Catálogo de cursos";
    var nivelActual = ViewData["NivelSeleccionado"] as string;
    var busquedaActual = ViewData["Busqueda"] as string;
}

<div class="container py-4">
    <h1 class="section-title">Catálogo de cursos</h1>

    <!-- Filtros y búsqueda -->
    <div class="card mb-4">
        <div class="card-header"><span>buscar.exe</span><span class="float-end">_ □ x</span></div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Buscar curso</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="busqueda" class="form-control"
                               placeholder="Buscar por título..." value="@busquedaActual" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Filtrar por nivel</label>
                    <select name="nivel" class="form-select">
                        <option value="">Todos los niveles</option>
                        <option value="Básico" selected="@(nivelActual == "Básico")">Básico</option>
                        <option value="Intermedio" selected="@(nivelActual == "Intermedio")">Intermedio</option>
                        <option value="Avanzado" selected="@(nivelActual == "Avanzado")">Avanzado</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    @if (!string.IsNullOrEmpty(busquedaActual))
    {
        <p class="text-muted mb-3">
            Resultados para: <strong>"@busquedaActual"</strong>
            (@Model.Count() encontrados)
        </p>
    }

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var curso in Model)
            {
                <div class="col">
                    <div class="card curso-card h-100">
                        <div class="card-header"><span>curso_@(curso.Id).html</span><span class="float-end">_ x</span></div>
                        @{
                            var nivelClase = curso.Nivel switch {
                                "Básico" => "nivel-basico",
                                "Intermedio" => "nivel-intermedio",
                                "Avanzado" => "nivel-avanzado",
                                _ => ""
                            };
                        }
                        <div class="curso-portada @nivelClase">&lt;/&gt; @curso.Nivel.ToUpper()</div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@curso.Titulo</h5>
                            <p class="card-text text-muted flex-grow-1">
                                @(curso.Descripcion.Length > 130 ? curso.Descripcion.Substring(0, 130) + "…" : curso.Descripcion)
                            </p>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="chip-info"><i class="bi bi-clock me-1"></i>@curso.Duracion min</span>
                                <span class="chip-info"><i class="bi bi-list-ul me-1"></i>@(curso.Lecciones?.Count ?? 0) lecc.</span>
                                <span class="chip-info"><i class="bi bi-calendar3 me-1"></i>@curso.FechaCreacion.ToString("dd/MM/yy")</span>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a asp-action="Detalle" asp-route-id="@curso.Id"
                               class="btn btn-outline-primary w-100">
                                Ver detalle <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card mx-auto" style="max-width:520px">
            <div class="card-header"><span>error_404.txt</span></div>
            <div class="card-body text-center py-5">
                <i class="bi bi-search" style="font-size:3rem;color:#4b3a9c"></i>
                <h3 class="mt-3">No se encontraron cursos</h3>
                <p class="text-muted">Intenta con otros filtros o términos de búsqueda.</p>
                <a asp-action="Index" class="btn btn-outline-primary mt-2">Ver todos los cursos</a>
            </div>
        </div>
    }
</div>
