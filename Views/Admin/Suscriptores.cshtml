@model IEnumerable<PortalMicrocursos.Models.Curso>
@{
    ViewData["Title"] = "Suscriptores por curso";
}

<div class="container py-4">
    <h1 class="section-title">Suscriptores por curso</h1>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var curso in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title fw-bold">@curso.Titulo</h5>
                                @if (curso.EstaPublicado)
                                {
                                    <span class="badge bg-success ms-2 flex-shrink-0">Publicado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark ms-2 flex-shrink-0">Borrador</span>
                                }
                            </div>
                            <p class="text-muted small mb-2">@curso.Nivel · @curso.Duracion min</p>
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-people-fill text-primary" style="font-size:1.4rem"></i>
                                <span class="fs-4 fw-bold">@(curso.Inscripciones?.Count ?? 0)</span>
                                <span class="text-muted">inscritos</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="SuscriptoresPorCurso" asp-route-id="@curso.Id"
                               class="btn btn-outline-primary w-100 btn-sm">
                                <i class="bi bi-person-lines-fill me-2"></i>Ver detalle
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-collection" style="font-size:4rem;color:#ccc"></i>
            <h3 class="mt-3">No hay cursos aún</h3>
        </div>
    }
</div>
