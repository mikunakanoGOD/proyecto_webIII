@model IEnumerable<PortalMicrocursos.Models.Inscripcion>
@{
    ViewData["Title"] = "Detalle de suscriptores";
    var curso = ViewData["Curso"] as PortalMicrocursos.Models.Curso;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Panel Admin</a></li>
            <li class="breadcrumb-item"><a asp-action="Suscriptores">Suscriptores</a></li>
            <li class="breadcrumb-item active">@curso?.Titulo</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="section-title mb-0">Suscriptores inscritos</h1>
            <p class="text-muted">Curso: <strong>@curso?.Titulo</strong></p>
        </div>
        <span class="badge bg-primary fs-6 py-2 px-3">
            <i class="bi bi-people-fill me-2"></i>@Model.Count() inscrito(s)
        </span>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-admin table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Correo electrónico</th>
                            <th>Fecha de inscripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int num = 1;}
                        @foreach (var inscripcion in Model.OrderBy(i => i.FechaInscripcion))
                        {
                            <tr>
                                <td class="text-muted align-middle">@(num++)</td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                             style="width:34px;height:34px;min-width:34px;font-size:0.85rem">
                                            @(inscripcion.Usuario?.NombreCompleto?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <span class="fw-semibold">
                                            @(inscripcion.Usuario?.NombreCompleto ?? "—")
                                        </span>
                                    </div>
                                </td>
                                <td class="align-middle text-muted">@inscripcion.Usuario?.Email</td>
                                <td class="align-middle text-muted small">
                                    @inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-muted small py-2 px-3">
                Total: <strong>@Model.Count()</strong> suscriptores inscritos
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-person-x" style="font-size:4rem;color:#ccc"></i>
            <h3 class="mt-3">Ningún suscriptor inscrito aún</h3>
            <p>Cuando alguien se inscriba en este curso aparecerá aquí.</p>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Suscriptores" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver a suscriptores
        </a>
    </div>
</div>
